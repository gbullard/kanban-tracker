@page
@model Kanban.Web.Pages.Cards.EditModel
@{ ViewData["Title"] = Model.Id is null ? "New card" : "Edit card"; }

<div style="padding:1rem;max-width:700px">
    <h2>@ViewData["Title"]</h2>

    @if (Model.Error is not null)
    {
        <p style="color:var(--tn-red)">@Model.Error</p>
    }

    <form method="post" style="display:flex;flex-direction:column;gap:.75rem">
        <input type="hidden" asp-for="Id" />

        <label>
            Project
            <select asp-for="ProjectId" style="width:100%">
                @foreach (var p in Model.Projects)
                {
                    <option value="@p.Id">@p.Name — @p.Path</option>
                }
            </select>
        </label>

        <label>
            Title
            <input asp-for="Title" style="width:100%" />
        </label>

        <label>
            Description — this is the brief the agent receives
            <textarea asp-for="Description" rows="10" style="width:100%"></textarea>
        </label>

        <div style="display:flex;gap:.5rem">
            <button type="submit">Save</button>
            <a href="/">Cancel</a>
        </div>
    </form>
</div>