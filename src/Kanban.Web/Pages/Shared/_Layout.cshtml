<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Kanban</title>
    <link rel="stylesheet" href="https://www.nerdfonts.com/assets/css/webfont.css" />
    <link id="theme-link" rel="stylesheet" href="~/css/tokyonight.css" />
    <link rel="stylesheet" href="~/css/board.css" />
    <script src="~/js/theme.js"></script>
</head>
<body>
    <header class="topbar">
        <a href="/" title="Board" class="topbar-icon"><i class="nf nf-fa-home"></i></a>
        @await RenderSectionAsync("Toolbar", required: false)
        <span style="flex:1"></span>
        <a href="/Settings" title="Settings" class="topbar-icon"><i class="nf nf-fa-gear"></i></a>
    </header>
    @RenderBody()
    <script src="~/lib/htmx/htmx.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>