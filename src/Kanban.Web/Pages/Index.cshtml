@page
@model Kanban.Web.Pages.IndexModel
@{ ViewData["Title"] = "Board"; }

@section Toolbar {
    <form method="get" style="display:flex;gap:.5rem;align-items:center">
        <select name="ProjectId" onchange="this.form.submit()">
            <option value="">All projects</option>
            @foreach (var p in Model.Projects)
            {
                <option value="@p.Id" selected="@(Model.ProjectId == p.Id)">@p.Name</option>
            }
        </select>
    </form>
    <a href="/Cards/Edit" class="topbar-btn"><i class="nf nf-cod-diff_added"></i></a>
}

@Html.AntiForgeryToken()
@{
    var boardUrl = "/?handler=Board";
    if (Model.ProjectId.HasValue)
    {
        boardUrl += $"&ProjectId={Model.ProjectId}";
    }
}
<div class="board" id="board" hx-get="@boardUrl" hx-trigger="every 5s" hx-swap="innerHTML">
    <partial name="_Board" model="Model.Columns" />
</div>

@section Scripts {
    <script src="~/lib/sortable/Sortable.min.js"></script>
    <script src="~/js/board.js"></script>
}